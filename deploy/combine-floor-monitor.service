[Unit]
Description=Combine Floor Monitor — REPORT-ONLY (tracks HWM/floor for the joint Topstep 50K combine; does NOT halt or flatten)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Silver-Bullet-ML-BMAD
# The ONLY value that changes on a combine reset. floor_state.json is bound to this
# id: change it and the monitor archives the old state and re-genesises the floor at
# $50,000 / $48,000 (prereg combine-restart-floor-hwm §2). Do not hand-edit or delete
# the state file — swapping this id is the whole procedure.
Environment=PROJECTX_ACCOUNT_ID=23884932
# Report-only per prereg mim-nb-risk-mechanics-removal Amendment 2 (2026-08-04).
# Set to 0 ONLY to deliberately re-arm halting — that reverses an explicit owner decision.
Environment=FLOOR_MONITOR_REPORT_ONLY=1
# COMBINE_START is legacy: it seeds the PF window only for a pre-binding state file.
# A genesised account records its own combine_start at first start, so leave this unset
# for any new account.
Environment=MONITOR_POLL_SEC=30
ExecStart=/root/Silver-Bullet-ML-BMAD/.venv/bin/python src/research/combine_floor_monitor.py
Restart=on-failure
RestartSec=30
StandardOutput=append:/root/Silver-Bullet-ML-BMAD/logs/combine_floor_monitor.log
StandardError=append:/root/Silver-Bullet-ML-BMAD/logs/combine_floor_monitor.log

[Install]
WantedBy=multi-user.target
