[Unit]
Description=GAP-1 Panic-Open Gap Fade — TS SIM paper trading (data/gap_fade/, data/trades.db)
After=network-online.target
Wants=network-online.target
# Tolerate a ~10-minute broker outage (20 tries x RestartSec=30s) before giving up.
# These two directives MUST live in [Unit] — systemd silently ignores
# StartLimitIntervalSec in [Service] and leaves the 10s default in place, which is
# how the first attempt at this fix looked applied and was not (verified with
# `systemctl show -p StartLimitIntervalUSec`).
# Giving up is now visible: trader-gap-fade is registered in
# tools/combine_ops_healthcheck.py, which reports a unit that is not active.
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
User=root
WorkingDirectory=/root/Silver-Bullet-ML-BMAD
# GAP-1 paper trading — TS SIM account SIM2797251F.
# Internal OHLC simulation runs in parallel as the authoritative OOS P&L record.
# Prospective OOS test from 2026-06-26; decision at N>=30 + 30 calendar days.
# Pre-reg seal 32da5d5 — _bmad-output/preregistration_gap_fade_panic_open.md
#
# QUARTERLY ROLL: update GAP_FADE_SYMBOL at each futures roll.
# Next: ~2026-09-11 → MNQZ26
#
# TS SIM toggle: set GAP_FADE_TS_SIM=0 to revert to internal-sim-only mode.
Environment=GAP_FADE_SYMBOL=MNQU26
Environment=GAP_FADE_TS_SIM=1
Environment=GAP_FADE_TS_SIM_ACCOUNT=SIM2797251F
ExecStart=/root/Silver-Bullet-ML-BMAD/.venv/bin/python src/research/gap_fade_live.py
# Restart=always, not on-failure (changed 2026-08-08).
# The bot's "10 consecutive tick failures — stopping" path shut down GRACEFULLY and
# exited 0, so systemd recorded Result=success and on-failure correctly declined to
# restart it. A TradeStation auth outage (HTTP 503) killed it at 12:58:52 UTC and it
# stayed dead for nine hours. YANK absorbed 1,581 of the same 503s, MIM-NB 13,782 —
# neither self-terminates. The polite exit is what defeated the restart policy.
# gap_fade_live.py now also exits 1 on that path (belt); always is the braces, and
# covers any other clean-exit route nobody has enumerated. An explicit
# `systemctl stop` still stops — systemd never restarts after an operator stop.
Restart=always
RestartSec=30
StandardOutput=append:/root/Silver-Bullet-ML-BMAD/logs/gap_fade_live.log
StandardError=append:/root/Silver-Bullet-ML-BMAD/logs/gap_fade_live.log

[Install]
WantedBy=multi-user.target
