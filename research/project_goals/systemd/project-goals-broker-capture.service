[Unit]
Description=Read-only broker evidence capture and local daily audit
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/root/Silver-Bullet-ML-BMAD
ExecStart=/root/Silver-Bullet-ML-BMAD/.venv/bin/python -m research.project_goals capture --root /root/Silver-Bullet-ML-BMAD --output /root/Silver-Bullet-ML-BMAD/research/project_goals/runs/broker-audit --account 26556101 --credentials /root/Silver-Bullet-ML-BMAD/.projectx_api_key
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/Silver-Bullet-ML-BMAD/research/project_goals/runs

[Install]
WantedBy=multi-user.target
